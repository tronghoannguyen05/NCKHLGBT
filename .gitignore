!tests/synthetic_kobo.csv

# --- Kết quả sinh tự động ---
output/logs/**
!output/**/.gitkeep

# --- Tệp tạm ---
*.stswp
*.smcl
*.tmp
~$*
.DS_Store
Thumbs.db
__pycache__/
