# --- Sensitive personal data: NEVER commit (Law 91/2025/QH15; Decree 356/2025/ND-CP) ---
data/**
!data/**/
!data/README.md
!data/**/.gitkeep
*.dta
*.sav
*.xlsx
*.xls
*.parquet
# CSV files are allowed only in config/ and output/tables/ (tables with small cells suppressed)
*.csv
!config/*.csv
!output/tables/*.csv
!output/tables/python_replication/*.csv
!output/tables/stata/*.csv
# SYNTHETIC data (record IDs SYN...), checked by tests/check_no_data.sh
!tests/synthetic_kobo.csv

# --- Generated output ---
output/logs/**
!output/**/.gitkeep

# --- Temporary files ---
*.stswp
*.smcl
*.tmp
~$*
.DS_Store
Thumbs.db
__pycache__/
